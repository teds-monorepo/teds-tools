{
  "name": "teds-tools",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 4502",
    "build": "next build",
    "start": "next start",
    "lint": "echo \"no lint (JS project)\" && exit 0",
    "typecheck": "echo \"no typecheck (JS project)\" && exit 0",
    "test": "echo \"no tests\" && exit 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp", "unrs-resolver"]
  },
  "prettier": {
    "singleQuote": true,
